rules_version = '2';

service cloud.firestore {
  function isValidFeedbackAttachment(attachment, feedbackId) {
    let pathSegments = attachment.path.split('/');
    return attachment is map
      && attachment.keys().hasOnly([
        'id', 'path', 'contentType', 'sizeBytes', 'downloadUrl'
      ])
      && attachment.keys().hasAll([
        'id', 'path', 'contentType', 'sizeBytes'
      ])
      && attachment.id is string
      && attachment.id.size() > 0
      && attachment.id.size() <= 100
      && attachment.path is string
      && attachment.path.matches('^feedback/[^/]+/[^/]+/[^/]+$')
      && pathSegments.size() == 4
      && pathSegments[0] == 'feedback'
      && pathSegments[1] == request.auth.uid
      && pathSegments[2] == feedbackId
      && pathSegments[3] == attachment.id
      && attachment.contentType is string
      && (
        attachment.contentType == 'image/jpeg' ||
        attachment.contentType == 'image/jpg' ||
        attachment.contentType == 'image/png' ||
        attachment.contentType == 'image/webp' ||
        attachment.contentType == 'image/heic' ||
        attachment.contentType == 'image/heif'
      )
      && attachment.sizeBytes is int
      && attachment.sizeBytes > 0
      && attachment.sizeBytes <= 5 * 1024 * 1024
      // Older app versions also send a download URL; newer ones don't.
      && (!attachment.keys().hasAny(['downloadUrl']) || (
        attachment.downloadUrl is string
        && attachment.downloadUrl.size() > 0
        && attachment.downloadUrl.size() <= 2048
      ));
  }

  function isValidFeedbackDiagnosticLog(log, feedbackId) {
    let pathSegments = log.path.split('/');
    return log is map
      && log.keys().hasOnly([
        'id', 'path', 'contentType', 'sizeBytes'
      ])
      && log.keys().hasAll([
        'id', 'path', 'contentType', 'sizeBytes'
      ])
      && log.id is string
      && log.id.size() > 0
      && log.id.size() <= 100
      && log.path is string
      && log.path.matches('^feedback/[^/]+/[^/]+/[^/]+$')
      && pathSegments.size() == 4
      && pathSegments[0] == 'feedback'
      && pathSegments[1] == request.auth.uid
      && pathSegments[2] == feedbackId
      && pathSegments[3] == log.id
      && log.contentType is string
      && log.contentType == 'text/plain'
      && log.sizeBytes is int
      && log.sizeBytes > 0
      && log.sizeBytes <= 5 * 1024 * 1024;
  }

  match /databases/{database}/documents {
    function isGoogleAccount(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.identities.keys().hasAny(['google.com']);
    }
    function activeAccount(uid) {
      return isGoogleAccount(uid)
        && get(/databases/$(database)/documents/accounts/$(uid)).data.active == true;
    }
    // Synced record ids: the app's preference allowlist (PortablePreferences.kt, mirrored in
    // functions/assistant-records.js PREFERENCE_NAMES and checked by a test) or a hashed key.
    function isRecordId(recordId) {
      return recordId.matches('^(p_(dynamic_color|apply_accent_to_app|vibration_enabled|gradual_volume_enabled|spoken_alarm_include_event_name|spoken_alarm_include_time_until_event|spoken_alarm_include_location|spoken_alarm_include_helpful_reminder|respect_dnd|override_dnd_for_priority|ignore_all_day_events|auto_detect_meeting_urls|override_system_volume|smart_snooze_suggestions|default_lead_time_minutes|alarm_volume|snooze_duration_minutes|alarm_duration_seconds|max_snoozes|spoken_alarm_speech_rate_hundredths|theme_preference|accent_id|default_lead_times_csv|alert_type|vibration_pattern|spoken_alarm_meeting_type_preference|spoken_alarm_repetition|rsvp_filter|alarms_paused_until)|[cse]_[a-f0-9]{64})$');
    }
    match /accounts/{uid} {
      allow read: if isGoogleAccount(uid);
      allow create: if isGoogleAccount(uid)
        && request.resource.data.keys().hasOnly(['active', 'schemaVersion'])
        && request.resource.data.active == true && request.resource.data.schemaVersion == 1;
      allow update, delete: if false;
      match /values/{recordId} {
        allow read: if activeAccount(uid);
        allow create, update: if activeAccount(uid)
          && isRecordId(recordId)
          && request.resource.data.keys().hasOnly(['payload'])
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 16384;
        // Phones delete an occurrence's record once its event has ended; other records stay.
        allow delete: if activeAccount(uid) && recordId.matches('^e_[a-f0-9]{64}$');
      }
      match /history/{recordId} {
        allow read: if activeAccount(uid);
        allow create, update: if activeAccount(uid)
          && recordId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['payload', 'createdAt'])
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 8192
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt >= request.time.toMillis() - 1209600000
          && request.resource.data.createdAt <= request.time.toMillis() + 300000;
        allow delete: if activeAccount(uid);
      }

      // Assistant connector (docs/ASSISTANT_PROTOCOL.md). The server writes assistant/state and
      // assistantActivity; a phone writes its own device and snapshot documents only while an
      // assistant is connected.
      function assistantConnected() {
        let state = /databases/$(database)/documents/accounts/$(uid)/assistant/state;
        return exists(state) && get(state).data.connected == true;
      }
      function isDeviceId(deviceId) {
        return deviceId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
      }
      function isValidDevice(data) {
        return data.keys().hasOnly(['platform', 'deviceName', 'appVersion', 'fcmToken', 'apnsToken', 'apnsEnvironment', 'deviceKeyHash', 'capabilities', 'lastPing', 'updatedAt'])
          && data.keys().hasAll(['platform', 'deviceName', 'appVersion', 'capabilities', 'updatedAt'])
          && data.platform in ['android', 'ios']
          && data.deviceName is string && data.deviceName.size() <= 100
          && data.appVersion is string && data.appVersion.size() <= 40
          && (!data.keys().hasAny(['fcmToken']) || (data.fcmToken is string && data.fcmToken.size() <= 4096
            && data.fcmToken.matches('^[A-Za-z0-9_:-]+$')))
          // iOS only: the APNs token and its environment (always together), and the SHA-256 of the
          // per-device key the notification extension uses for assistantDeviceApi.
          && (!data.keys().hasAny(['apnsToken', 'apnsEnvironment', 'deviceKeyHash']) || data.platform == 'ios')
          && (data.keys().hasAll(['apnsToken', 'apnsEnvironment']) || !data.keys().hasAny(['apnsToken', 'apnsEnvironment']))
          && (!data.keys().hasAny(['apnsToken']) || (data.apnsToken is string && data.apnsToken.matches('^[0-9a-f]{64,200}$')))
          && (!data.keys().hasAny(['apnsEnvironment']) || data.apnsEnvironment in ['development', 'production'])
          && (!data.keys().hasAny(['deviceKeyHash']) || (data.deviceKeyHash is string && data.deviceKeyHash.matches('^[0-9a-f]{64}$')))
          && data.capabilities is list && data.capabilities.size() <= 20
          && data.capabilities.hasOnly(['travel', 'spokenAlarms', 'plus', 'pause'])
          && (!data.keys().hasAny(['lastPing']) || (
            data.lastPing is map
            && data.lastPing.keys().hasOnly(['id', 'receivedAt']) && data.lastPing.keys().hasAll(['id', 'receivedAt'])
            && data.lastPing.id is string && data.lastPing.id.size() <= 64
            && data.lastPing.receivedAt is timestamp && data.lastPing.receivedAt <= request.time))
          && data.updatedAt == request.time;
      }
      function isValidSnapshot(data) {
        return data.keys().hasOnly(['schemaVersion', 'publishedAt', 'requestId', 'payload'])
          && data.keys().hasAll(['schemaVersion', 'publishedAt', 'payload'])
          && data.schemaVersion == 1
          && data.publishedAt == request.time
          && (!data.keys().hasAny(['requestId']) || (data.requestId is string && data.requestId.size() <= 64))
          // The phone trims its snapshot to fit this (AssistantSnapshot.MAX_PAYLOAD_CHARS); the
          // server checks the same limit (MAX_SNAPSHOT_CHARS) before parsing one.
          && data.payload is string && data.payload.size() <= 800000;
      }
      match /assistant/{document} {
        allow read: if document == 'state' && activeAccount(uid);
        allow write: if false;
      }
      match /assistantDevices/{deviceId} {
        allow read, delete: if activeAccount(uid);
        allow create, update: if activeAccount(uid) && isDeviceId(deviceId) && assistantConnected()
          && isValidDevice(request.resource.data);
      }
      match /assistantSnapshots/{deviceId} {
        allow read, delete: if activeAccount(uid);
        allow create, update: if activeAccount(uid) && isDeviceId(deviceId) && assistantConnected()
          && isValidSnapshot(request.resource.data);
      }
      match /assistantActivity/{changeId} {
        allow read: if activeAccount(uid);
        allow write: if false;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'message', 'contactEmail', 'attachments', 'diagnosticLog', 'createdAt', 'appVersion', 'source'
        ])
        && request.resource.data.keys().hasAll([
          'message', 'contactEmail', 'attachments', 'createdAt', 'appVersion', 'source'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() > 0
        && request.resource.data.contactEmail.size() <= 254
        && request.resource.data.contactEmail.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 3
        && (
          request.resource.data.attachments.size() < 1 ||
          isValidFeedbackAttachment(request.resource.data.attachments[0], feedbackId)
        )
        && (
          request.resource.data.attachments.size() < 2 ||
          isValidFeedbackAttachment(request.resource.data.attachments[1], feedbackId)
        )
        && (
          request.resource.data.attachments.size() < 3 ||
          isValidFeedbackAttachment(request.resource.data.attachments[2], feedbackId)
        )
        && (
          !request.resource.data.keys().hasAny(['diagnosticLog']) ||
          isValidFeedbackDiagnosticLog(request.resource.data.diagnosticLog, feedbackId)
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 100
        && request.resource.data.source == 'android';
      allow read, update, delete: if false;
    }

    // iOS relay push state is written only by Cloud Functions through the Admin SDK, which
    // bypasses these rules. Clients get no access to any document or subcollection.
    match /iosPushInstalls/{document=**} {
      allow read, write: if false;
    }

    match /iosPushSubscriptions/{document=**} {
      allow read, write: if false;
    }

    match /iosPushRateLimits/{document=**} {
      allow read, write: if false;
    }

    match /iosPushDispatches/{document=**} {
      allow read, write: if false;
    }

    // Per-install route call counters, written only by the route function.
    match /travelRouteUsage/{document=**} {
      allow read, write: if false;
    }

    // Assistant connector OAuth state, anonymous usage totals and rate limit counters: written and
    // read only by Cloud Functions through the Admin SDK.
    match /oauthClients/{document=**} {
      allow read, write: if false;
    }

    match /oauthRequests/{document=**} {
      allow read, write: if false;
    }

    match /oauthCodes/{document=**} {
      allow read, write: if false;
    }

    match /oauthGrants/{document=**} {
      allow read, write: if false;
    }

    match /oauthTokens/{document=**} {
      allow read, write: if false;
    }

    match /assistantUsage/{document=**} {
      allow read, write: if false;
    }

    match /assistantRateLimits/{document=**} {
      allow read, write: if false;
    }
  }
}
