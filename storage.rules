rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Older app versions ask for a download URL after each upload, which needs read permission
    // for the uploader, and drop the image if that fails. Scope it to the uploader's own folder.
    // Remove it once app versions that no longer ask are widespread. Uploads no feedback document
    // references are deleted after a day (functions/storage-limits.js).
    match /feedback/{userId}/{feedbackId}/{attachmentId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Create only: each attachment is a new object, so nothing can be overwritten or reused.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && resource == null
        && request.resource != null
        && request.resource.contentType is string
        && (
          (
            request.resource.contentType.matches('^image/(jpeg|jpg|png|webp|heic|heif)$')
            && request.resource.size > 0
            && request.resource.size <= 5 * 1024 * 1024
          ) || (
            request.resource.contentType == 'text/plain'
            && request.resource.size > 0
            && request.resource.size <= 5 * 1024 * 1024
          )
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
